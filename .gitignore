# Python cache files (matches your __pycache__ error)
__pycache__/
*.py[cod]
*$py.class

# Django-specific exclusions
# Local settings (never push sensitive data like DB credentials)
whatslearn/settings/local.py
# Media files (user-uploaded content—usually too large for Git)
whatslearn/media/
# Static files (generated by collectstatic—rebuild on server)
whatslearn/static/
# Environment variables
.env
.env.local
# Virtual environment (never push your venv!)
venv/
env/
django/  # If this is your virtual env directory (adjust as needed)

# General Git ignores
# OS files
.DS_Store
Thumbs.db
# IDE/editor files
.idea/
.vscode/
*.swp
*.swo
# Logs
*.log
logs/
# Temporary files
tmp/
temp/